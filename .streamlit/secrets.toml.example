# 배포(Streamlit Community Cloud > App settings > Secrets)에 이 내용을 넣는다.
# 로컬에서 Supabase 를 쓰려면 이 파일을 secrets.toml 로 복사. 없으면 data/callcenter.db(SQLite)를 쓴다.
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_KEY = "service_role(sb_secret) 키 — 외부 공유 금지"
ANTHROPIC_API_KEY = "sk-ant-..."
APP_PASSWORD = "콜센터 공용 비밀번호"
